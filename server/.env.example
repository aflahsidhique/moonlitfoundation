DATABASE_URL=""
JWT_SECRET="change-this-to-a-long-random-string"
PORT=4000

# Seeded on first `npm run seed` — change the password after first login.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# Comma-separated list of origins allowed to call this API.
# Local dev: the React app runs on the Vite dev server (http://localhost:5173).
# In production, this is the deployed frontend's origin
# (e.g. https://moonlit-website.onrender.com) — see render.yaml.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,null"

# Cloudinary — volunteer photo + ID document uploads are stored here.
# Get these from your Cloudinary dashboard (cloudinary.com/console).
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Volunteer portal base URL (no trailing slash) — /login and /reset-password
# are appended by the server. Linked in the approval email/SMS and password
# reset emails.
PORTAL_URL="http://localhost:5173/portal"

# Public website origin used by event invitation links. Set the deployed site URL in production.
SITE_URL="http://localhost:5173"

# Gmail SMTP — sends the "you're approved" email (volunteer ID + password +
# portal link). GMAIL_USER is the full Gmail address; GMAIL_APP_PASSWORD is
# a 16-character App Password (Google Account → Security → App Passwords —
# requires 2-Step Verification to be enabled). Your normal Gmail password
# will NOT work here. Leave both unset to skip email sending (approval still
# succeeds; the admin panel will just show "email: not configured").
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# SMS Gate (https://sms-gate.app) — sends the same approval details via SMS.
# SMSGATE_BASE_URL is https://api.sms-gate.app/3rdparty/v1 for the hosted
# cloud service, or your own device's local/private URL if self-hosting.
# SMSGATE_USERNAME/PASSWORD are the Basic Auth credentials from your SMS
# Gate account (registered per-device). Leave unset to skip SMS sending.
SMSGATE_BASE_URL="https://api.sms-gate.app/3rdparty/v1"
SMSGATE_USERNAME=""
SMSGATE_PASSWORD=""

# Web Push — generate once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Do not regenerate after volunteers have subscribed — a new keypair
# invalidates every existing subscription.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Optional Instagram Login API: enables new-reel discovery in the refresh script.
# These values are read only by client/scripts/sync-instagram.mjs, never the browser.
# Leave empty to refresh previews for the existing public reel links without an API.
INSTAGRAM_USER_ID=""
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_API_VERSION="v25.0"
