generator client {
  provider = "prisma-client-js"
}


model WebsiteContent {
  id                String   @id
  draft             Json
  published         Json
  revision          Int      @default(1)
  publishedRevision Int      @default(0)
  publishedAt       DateTime?
  updatedAt         DateTime @updatedAt
}

model WebsiteImage {
  id          String   @id @default(cuid())
  publicId    String?  @unique
  imageUrl    String
  contentHash String?  @unique
  width       Int?
  height      Int?
  bytes       Int?
  format      String   @default("webp")
  title       String
  alt         String
  caption     String   @default("")
  category    String   @default("welfare")
  status      String   @default("draft")
  inGallery   Boolean  @default(false)
  sortOrder   Int      @default(0)
  revision    Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([inGallery, status, deletedAt, sortOrder])
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

















model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin")
  permissions  Json     @default("[]")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Volunteer {
  id          String    @id @default(cuid())
  volunteerId String?   @unique
  passwordHash String?



  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?


  fullName String
  dob      DateTime
  gender   String
  aadhaar  String?
  photoUrl String?
  mobile   String @unique
  whatsapp String?
  email    String @unique


  address   String
  state     String
  district  String
  taluk     String
  panchayat String
  ward      String
  pin       String


  emergencyName         String
  emergencyRelationship String
  emergencyPhone        String

  skills String


  bloodGroup             String?
  isBloodDonor           Boolean   @default(false)
  lastBloodDonationDate  DateTime?
  bloodDonationAvailable Boolean   @default(true)
  weight                 Float?
  medicalConditions      String?


  lat Float?
  lng Float?

  availableTime String


  instagram String?
  facebook  String?
  linkedin  String?


  idType     String?
  idUploadUrl String?

  message   String?
  status    String   @default("pending")
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendances           Attendance[]
  notifications         Notification[]
  bloodDonations        BloodDonationRecord[]
  bloodRequestResponses BloodRequestResponse[]
  pushSubscriptions     PushSubscription[]
}

model BloodRequest {
  id            String   @id @default(cuid())
  submissionKey String? @unique
  patientName   String
  bloodGroup    String
  units         Int
  urgency       String
  hospital      String
  district      String
  location      String
  doctorName    String?
  phone         String
  documentUrls  String?
  status        String   @default("pending")
  adminNote     String?


  lat Float?
  lng Float?

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses BloodRequestResponse[]
  donations BloodDonationRecord[]
}



model BloodRequestResponse {
  id             String    @id @default(cuid())
  bloodRequestId String
  bloodRequest   BloodRequest @relation(fields: [bloodRequestId], references: [id], onDelete: Cascade)
  volunteerId    String
  volunteer      Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  response       String?
  status         String    @default("notified")
  respondedAt    DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([bloodRequestId, volunteerId])
}




model BloodDonationRecord {
  id             String    @id @default(cuid())
  volunteerId    String
  volunteer      Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  donationDate   DateTime
  location       String?
  notes          String?
  bloodRequestId String?
  bloodRequest   BloodRequest? @relation(fields: [bloodRequestId], references: [id], onDelete: SetNull)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
}


model PushSubscription {
  id          String    @id @default(cuid())
  volunteerId String
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  endpoint    String    @unique
  p256dh      String
  auth        String
  createdAt   DateTime  @default(now())
}

model PartnerInquiry {
  id            String   @id @default(cuid())
  submissionKey String?  @unique
  organization  String
  contactPerson String
  email         String
  message       String
  status        String   @default("pending")
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String
  subject   String
  message   String
  status    String   @default("unread")
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  deletedAt DateTime?
  createdAt DateTime @default(now())
}

model Event {
  id            String               @id @default(cuid())
  title         String
  category      String
  description   String
  location      String
  eventDate     DateTime
  startTime     String
  endTime       String
  durationHours Float?
  imageUrl      String?
  photoAlbumUrl String?
  capacity      Int?
  status        String               @default("draft")
  deletedAt     DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  registrations EventRegistration[]
  attendances   Attendance[]
  feedback      EventFeedback[]
}

model EventRegistration {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  email     String
  phone     String
  status    String   @default("pending")
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}




model Attendance {
  id            String    @id @default(cuid())
  volunteerId   String
  volunteer     Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  eventId       String
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  hoursCredited Float      @default(0)
  checkedInAt   DateTime  @default(now())



  certificateIssued   Boolean   @default(false)
  certificateIssuedAt DateTime?

  @@unique([volunteerId, eventId])
}



model EventFeedback {
  id        String    @id @default(cuid())
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  email     String
  rating    Int
  comment   String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
}



model Notification {
  id          String     @id @default(cuid())
  title       String
  message     String
  audience    String     @default("all")
  volunteerId String?
  volunteer   Volunteer? @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
}
